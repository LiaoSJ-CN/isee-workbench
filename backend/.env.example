# iSee Data Analysis Workbench — Backend Configuration
# Copy this file to .env and adjust values for your deployment.

# =============================================================================
# Application
# =============================================================================

# Application display name
APP_NAME=iSee Data Analysis Workbench

# FastAPI debug mode — set to false in production
DEBUG=false

# =============================================================================
# Metadata database (users / reports / data sources / scheduler state)
# =============================================================================
# SQLite (single-node dev):
#   sqlite:///./app.db
# PostgreSQL (recommended for multi-node / production):
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

# Allowed CORS origins (JSON array of strings).
# Add your frontend URLs here if the frontend is served from a different origin.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# =============================================================================
# Auth (P3 hardening)
# =============================================================================

# Bootstrap admin account — change both in production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# JWT signing key — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production. Without it, all tokens are invalidated on every
# restart and every user is silently logged out.
JWT_SECRET_KEY=

# JWT algorithm (HS256 is fine for single-service deployments)
JWT_ALGORITHM=HS256

# Token lifetimes
ACCESS_TOKEN_MINUTES=1440   # 24 hours
REFRESH_TOKEN_DAYS=7        # 7 days

# =============================================================================
# Login brute-force protection
# =============================================================================
# Max login attempts per IP per minute before returning HTTP 429.
LOGIN_RATE_LIMIT=10

# =============================================================================
# Cookie auth (P3 / SEC-6)
# =============================================================================
# When true, login/refresh set HttpOnly+SameSite cookies in addition to the
# Authorization: Bearer header. Required for browsers served over HTTPS.
COOKIE_AUTH_ENABLED=true

# Cookie Secure flag. MUST be true in production (HTTPS); false in local dev
# so the browser accepts the cookie on http://localhost.
COOKIE_SECURE=false

# Cookie SameSite policy. "lax" blocks cross-site POST (CSRF defense) while
# still allowing the cookie to flow on same-site XHR and top-level GETs.
COOKIE_SAMESITE=lax

# Cookie names — keep defaults unless you run two deployments on one host.
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# =============================================================================
# Trusted reverse proxies (P3.5 / PY-12)
# =============================================================================
# Comma-separated list of IPs / CIDRs that may set X-Forwarded-For. When the
# immediate peer is in this list, the rightmost non-trusted hop is used as the
# real client IP (needed for accurate rate-limit attribution behind nginx /
# HAProxy). Default empty — safe for dev and direct-connect deploys.
# TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1/32

# =============================================================================
# Security headers (P5 / SEC-5)
# =============================================================================
# When true, the SecurityHeadersMiddleware attaches X-Content-Type-Options,
# X-Frame-Options, Referrer-Policy, and Permissions-Policy to every response.
SECURITY_HEADERS_ENABLED=true

# =============================================================================
# Webhook security (P4)
# =============================================================================
# Shared secret for HMAC-SHA256 signing of webhook payloads.
# The receiver validates the X-Webhook-Signature header with the same secret.
# Empty by default — webhooks are still sent, but unsigned (NOT recommended
# for production).
WEBHOOK_SECRET=

# When true, webhook URLs must use HTTPS (blocks plaintext HTTP). Set false
# for local dev/testing only.
WEBHOOK_HTTPS_ONLY=false

# Max age (seconds) of a webhook timestamp for replay protection.
# Payloads older than this are rejected by the receiver.
WEBHOOK_TIMESTAMP_MAX_AGE=300

# =============================================================================
# Database connection pool
# =============================================================================
# Only applied when DATABASE_URL is not SQLite (SQLite uses a single-
# connection NullPool that ignores these).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# =============================================================================
# Data-source password encryption at rest
# =============================================================================
# Fernet key — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in production. Changing this key makes existing encrypted
# passwords unreadable.
ENCRYPTION_KEY=

# =============================================================================
# Scheduler
# =============================================================================
# Sidecar deployment mode (recommended for production):
#   Web process:     SCHEDULER_DISABLED=true (default)
#   Sidecar process: run `python -m app.scheduler_runner` separately
# Single-process dev mode:
#   Set SCHEDULER_DISABLED=false to run the scheduler inside the web process.
SCHEDULER_DISABLED=true
SCHEDULER_RESYNC_INTERVAL=30

# =============================================================================
# Data explorer (/explorer/query)
# =============================================================================
# Hard cap on rows returned by /explorer/query. Prevents memory exhaustion
# when a user runs an unbounded SELECT. Wrap is SELECT * FROM (user_sql)
# AS _explorer_sub LIMIT N — ORDER BY in the user SQL is preserved.
EXPLORER_MAX_ROWS=10000

# Statement timeout (seconds) for explorer queries against PostgreSQL-family
# backends. 0 = no timeout. SQLite ignores this setting.
EXPLORER_STATEMENT_TIMEOUT=30

# =============================================================================
# Report output
# =============================================================================
# Directory for generated report files (HTML / Excel).
# Defaults to backend/generated_reports/ if left empty.
# GENERATED_REPORTS_DIR=

# =============================================================================
# Logging
# =============================================================================
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
